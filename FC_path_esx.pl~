#use warnings;

#Variables-------------------------------------------------
#$tmpfile = ".out.tmp";
$tmpfile = "mpath.out";
$num = "4";
#End-------------------------------------------------------

#Get the number of luns by running the esxcfg-mpath -l > .out.tmp
if (!-e $tmpfile) {
	system "esxcfg-mpath -l > $tmpfile";
}
open (TMP, "$tmpfile");
while (<TMP>) {
	@lines = split(/ /,$_);
	if ($lines[1] =~ m/^vmhba0|1./) {
		print "esxcfg-mpath --policy=fixed --lun=$lines[1]\n";
		print "esxcfg-mpath --preferred ";
		print "lun=$lines[1] ";
		}
	if ($lines[4] =~ m/^vmhba0|1./) {
		if ($lines[6] =~ m/active/) {
			print "path=$lines[4]\n";
		}
	}
}


